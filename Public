index.html
* { box-sizing: border-box; }

:root {
  --bg-1: #07131d;
  --bg-2: #0d1c2b;
  --bg-3: #12283d;
  --panel: rgba(13, 28, 43, 0.9);
  --panel-soft: rgba(17, 35, 52, 0.86);
  --panel-alt: rgba(255, 255, 255, 0.03);
  --line: rgba(255, 255, 255, 0.08);
  --gold: #f4c867;
  --gold-strong: #e7af2d;
  --text: #edf3ff;
  --muted: #aabbc9;
  --danger: #ff6b6b;
  --success: #34d399;
  --shadow: 0 18px 40px rgba(2, 6, 14, 0.38);
}

html, body {
  margin: 0;
  min-height: 100%;
  font-family: Arial, Helvetica, sans-serif;
  background: linear-gradient(180deg, var(--bg-1) 0%, var(--bg-2) 35%, var(--bg-3) 100%);
  color: var(--text);
}

body {
  min-height: 100vh;
}

button, input, textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

img {
  display: block;
  max-width: 100%;
}

input, textarea {
  border: 1px solid var(--line);
  background: rgba(9, 19, 28, 0.8);
  color: var(--text);
  border-radius: 12px;
  outline: none;
}

input::placeholder, textarea::placeholder {
  color: #93a4b8;
}

input:focus, textarea:focus {
  border-color: rgba(244, 200, 103, 0.6);
  box-shadow: 0 0 0 3px rgba(244, 200, 103, 0.12);
}

.hidden {
  display: none !important;
}

#app {
  min-height: 100vh;
}

.auth-wrap {
  min-height: 100vh;
  display: grid;
  place-items: center;
  padding: 24px;
}

.auth-card {
  width: min(520px, 100%);
  background: rgba(7, 18, 29, 0.88);
  border: 1px solid var(--line);
  border-radius: 28px;
  box-shadow: var(--shadow);
  padding: 28px 24px;
}

.brand-lockup {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14px;
  margin-bottom: 24px;
}

.brand-mark {
  width: 54px;
  height: 54px;
  border-radius: 18px;
  display: grid;
  place-items: center;
  font-weight: 900;
  font-size: 1.5rem;
  background: linear-gradient(135deg, var(--gold), var(--gold-strong));
  color: #132240;
}

.brand-kicker {
  font-size: 0.72rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: var(--muted);
}

.brand-lockup h1 {
  margin: 4px 0 0;
  font-size: clamp(2rem, 6vw, 2.7rem);
  letter-spacing: 0.08em;
  color: var(--gold);
}

.auth-panel {
  background: rgba(255,255,255,0.02);
  border: 1px solid var(--line);
  border-radius: 20px;
  padding: 18px;
}

.auth-tabs {
  display: flex;
  gap: 8px;
  background: rgba(255,255,255,0.03);
  border: 1px solid var(--line);
  padding: 6px;
  border-radius: 12px;
  margin-bottom: 18px;
}

.auth-tabs button {
  flex: 1;
  border: none;
  border-radius: 10px;
  background: transparent;
  color: var(--muted);
  padding: 12px 10px;
  font-weight: 700;
}

.auth-tabs button.active {
  background: linear-gradient(135deg, var(--gold), var(--gold-strong));
  color: #132240;
}

.auth-form {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.auth-form input {
  width: 100%;
  padding: 13px 14px;
}

.form-error {
  min-height: 18px;
  color: var(--danger);
  font-size: 0.82rem;
}

.primary-btn, .ghost-action, .friend-btn, .upload-label {
  border: none;
  border-radius: 12px;
  padding: 11px 14px;
  font-weight: 700;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

.primary-btn {
  background: linear-gradient(135deg, var(--gold), var(--gold-strong));
  color: #132240;
}

.primary-btn.small {
  padding: 9px 12px;
  font-size: 0.8rem;
}

.primary-btn.wide {
  width: 100%;
}

.primary-btn:hover, .ghost-action:hover, .friend-btn:hover, .upload-label:hover {
  transform: translateY(-1px);
}

.baraza-shell {
  width: min(1400px, 100%);
  margin: 0 auto;
  min-height: 100vh;
  padding: 20px 16px 32px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  background: rgba(12, 28, 42, 0.9);
  border: 1px solid var(--line);
  border-radius: 22px;
  padding: 16px 18px;
  box-shadow: var(--shadow);
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 12px;
}

.brand-block .brand-mark {
  width: 42px;
  height: 42px;
  border-radius: 14px;
  font-size: 1.1rem;
}

.brand-kicker {
  font-size: 0.72rem;
  color: var(--muted);
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.brand-title {
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--gold);
}

.top-actions {
  display: flex;
  align-items: center;
  gap: 12px;
}

.searchbox {
  min-width: min(320px, 42vw);
}

.searchbox input {
  width: 100%;
  padding: 11px 13px;
}

.dashboard {
  display: grid;
  grid-template-columns: 280px minmax(0, 1fr) 260px;
  gap: 22px;
  margin-top: 22px;
}

.left-panel, .main-panel, .right-panel {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.profile-card, .side-box, .composer-card, .post-card {
  background: rgba(12, 28, 42, 0.88);
  border: 1px solid var(--line);
  border-radius: 20px;
  box-shadow: var(--shadow);
}

.profile-card, .side-box {
  padding: 18px;
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 12px;
}

.profile-avatar, .mini-avatar {
  width: 42px;
  height: 42px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  font-weight: 800;
  background: linear-gradient(135deg, #d2a83b, #7e5417);
  color: #1d2d40;
}

.profile-name {
  font-size: 1.02rem;
  font-weight: 700;
}

.profile-handle {
  color: var(--muted);
  font-size: 0.82rem;
}

.profile-bio {
  margin: 16px 0 0;
  color: var(--muted);
  line-height: 1.6;
}

.mini-stats {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 18px;
}

.mini-stat {
  background: rgba(255,255,255,0.03);
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 12px 10px;
  text-align: center;
}

.mini-stat strong {
  display: block;
  font-size: 1.3rem;
  color: var(--gold);
}

.mini-stat span {
  color: var(--muted);
  font-size: 0.76rem;
}

.side-box h3 {
  margin: 0 0 14px;
  color: var(--gold);
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 0.82rem;
}

.people-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.person-row {
  display: flex;
  align-items: center;
  gap: 10px;
  background: rgba(255,255,255,0.02);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 10px 8px;
}

.person-meta {
  flex: 1;
  min-width: 0;
}

.person-meta strong,
.person-meta span {
  display: block;
}

.person-meta span {
  color: var(--muted);
  font-size: 0.72rem;
}

.friend-btn {
  background: rgba(244, 200, 103, 0.12);
  color: var(--gold);
  border: 1px solid rgba(244, 200, 103, 0.2);
  padding: 8px 10px;
}

.empty-mini {
  color: var(--muted);
  font-size: 0.82rem;
}

.composer-card {
  padding: 18px;
}

.composer-header {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 14px;
}

.composer-title {
  font-weight: 700;
}

#composerForm {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

#composerForm textarea {
  width: 100%;
  min-height: 120px;
  resize: vertical;
  padding: 14px 15px;
}

#composerForm input[type="url"] {
  width: 100%;
  padding: 12px 14px;
}

.upload-preview {
  width: 100%;
  max-height: 260px;
  object-fit: cover;
  border-radius: 16px;
  border: 1px solid var(--line);
}

.composer-tools {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.upload-label {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.03);
  color: var(--text);
  border: 1px solid var(--line);
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.upload-label input {
  position: absolute;
  inset: 0;
  opacity: 0;
  cursor: pointer;
}

.feed-wrap {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.post-card {
  padding: 18px;
}

.post-head {
  display: flex;
  align-items: center;
  gap: 12px;
}

.post-info {
  min-width: 0;
}

.post-author {
  font-weight: 700;
}

.post-time {
  color: var(--muted);
  font-size: 0.75rem;
  margin-top: 2px;
}

.shared-tag {
  display: inline-flex;
  margin-top: 16px;
  border-radius: 999px;
  padding: 5px 10px;
  background: rgba(52, 211, 153, 0.1);
  color: var(--success);
  border: 1px solid rgba(52, 211, 153, 0.2);
  font-size: 0.72rem;
  font-weight: 700;
}

.post-body {
  margin-top: 16px;
  color: var(--text);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
}

.post-image {
  width: 100%;
  min-height: 180px;
  max-height: 420px;
  object-fit: cover;
  border-radius: 18px;
  margin-top: 16px;
  border: 1px solid var(--line);
}

.post-actions {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  margin-top: 16px;
}

.ghost-action {
  background: rgba(255,255,255,0.03);
  color: var(--text);
  border: 1px solid var(--line);
}

.ghost-action.active {
  background: rgba(244, 200, 103, 0.12);
  color: var(--gold);
  border-color: rgba(244, 200, 103, 0.2);
}

.comment-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  margin-top: 16px;
}

.comment-item {
  background: rgba(255,255,255,0.02);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 10px 12px;
}

.comment-item strong {
  color: var(--gold);
}

.comment-item span {
  display: block;
  margin-top: 5px;
  color: var(--text);
  line-height: 1.5;
}

.empty-comment {
  color: var(--muted);
}

.comment-form {
  display: flex;
  gap: 8px;
  margin-top: 16px;
}

.comment-form input {
  flex: 1;
  min-width: 0;
  padding: 10px 12px;
}

.empty-state {
  background: rgba(12, 28, 42, 0.88);
  border: 1px dashed var(--line);
  color: var(--muted);
  border-radius: 20px;
  padding: 36px 18px;
  text-align: center;
}

.trend-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.trend-list li {
  display: flex;
  justify-content: space-between;
  gap: 8px;
  padding: 10px 12px;
  border-radius: 12px;
  background: rgba(255,255,255,0.02);
  border: 1px solid var(--line);
}

.trend-list span {
  color: var(--text);
}

.trend-list strong {
  color: var(--gold);
  font-size: 0.8rem;
}

.notification-item {
  background: rgba(255,255,255,0.02);
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 12px;
  margin-top: 10px;
}

.notification-item strong {
  display: block;
  font-size: 0.88rem;
  color: var(--gold);
}

.notification-item span {
  display: block;
  margin-top: 5px;
  color: var(--muted);
  line-height: 1.5;
  font-size: 0.8rem;
}

@media (max-width: 1100px) {
  .dashboard {
    grid-template-columns: 1fr;
  }

  .left-panel, .right-panel {
    order: 2;
  }

  .main-panel {
    order: 1;
  }
}

@media (max-width: 640px) {
  .topbar {
    flex-direction: column;
    align-items: stretch;
  }

  .top-actions {
    width: 100%;
    flex-direction: column;
    align-items: stretch;
  }

  .searchbox {
    min-width: 0;
    width: 100%;
  }

  .composer-tools {
    flex-direction: column;
    align-items: stretch;
  }

  .comment-form {
    flex-direction: column;
  }

  .comment-form .primary-btn {
    width: 100%;
  }
}

